# Copy to .env and fill in. The scripts load it with python-dotenv; tests never need it.
# Leave a key commented out if you use `ant auth login` - an empty value would override your profile.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# OPENAI_API_KEY=sk-...
# Pick a current OpenAI model that supports tool calling:
OPENAI_MODEL=

# Local models through Ollama instead of OpenAI:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=<a local model with tool support>
